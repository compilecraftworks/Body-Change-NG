    "My Presets.xml\u001fPreset B", // 같은 XML의 프리셋 B / Preset B in the same XML
    "My Pack/Other Presets.xml\u001fPreset C" // 다른 XML/하위 폴더 / Different XML/subfolder
  ]
}
END EXAMPLE */

